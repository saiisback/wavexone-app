{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wavexone-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "wavexone-web-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_WAVEX_BACKEND=mock",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    }
  ]
}
