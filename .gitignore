# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local agent tooling state
/.kilo

# API collections. These hold literal account tokens and device fingerprints in
# ~80 URLs (guide §6.1) and must never reach the remote. Keep them local; the
# endpoint contract derived from them lives in src/backend/endpoints.ts.
*postman_collection.json
*postman_environment*.json

# Local release exports and automation state
/.local-artifacts/
/.claude/
/.superpowers/
*.apk
*.aab
/app-store-*/
/app-store-*.zip
/fresh-app-store-assets/

# Environment files (including credentials); examples may be tracked
.env
.env.*
!.env.example
